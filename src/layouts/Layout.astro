---
import "../styles/global.css";
---


<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Melanchthon Bonifacio</title>
	</head>
<body class="min-h-screen bg-slate-50 antialiased">
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
            <!-- Logo -->
            <a href="/" class="text-lg font-semibold text-slate-900">Melanchthon Bonifacio</a>
            
            <!-- Desktop Navigation -->
            <div class="hidden space-x-8 md:flex">
                <a href="/about" class="text-slate-600 hover:text-slate-900">About</a>
                <a href="/blog" class="text-slate-600 hover:text-slate-900">Blog</a>
                <a href="/projects" class="text-slate-600 hover:text-slate-900">Projects</a>
            </div>
            
            <!-- Mobile Menu Button -->
            <button class="md:hidden" aria-label="Open menu">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </nav>
    </header>

    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="min-h-screen py-8 md:py-12">
				<!-- <div class="min-h-[calc(100vh-14rem)] py-8 md:py-12"> -->
			<!-- Content Container -->
            <div class="mx-auto max-w-3xl">
                <slot />
            </div>
        </div>
    </main>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
                <p class="text-sm text-slate-600">&copy; 2025 Melanchthon Bonifacio. All rights reserved.</p>
                <div class="flex space-x-4">
                    <a href="https://github.com/you" class="text-slate-600 hover:text-slate-900">
                        <span class="sr-only">GitHub</span>
                        <!-- GitHub SVG icon -->
                    </a>
                    <!-- Other social links -->
                </div>
            </div>
        </div>
    </footer>
</body>
</html>